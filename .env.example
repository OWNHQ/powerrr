# Shared local runtime
NUXT_PUBLIC_SITE_NAME=Powerrr
POWERRR_DATA_MODE=fixtures
POWERRR_INTERNAL_API_TOKEN=replace-with-a-secret-for-non-local-use
POWERRR_INTERNAL_SIGNING_SECRET=replace-with-a-signing-secret-for-non-local-use
POWERRR_SOURCE_CLIENT_TIMEOUT_MS=2500
POWERRR_MAX_BODY_BYTES=65536
POWERRR_REQUEST_TIMEOUT_MS=15000
POWERRR_TRUST_PROXY=false

# Required before using POWERRR_RUNTIME_TIER=production. The preview falls back
# to bounded in-process state; production uses this for shared cache/rate limits.
POWERRR_REDIS_REST_URL=
POWERRR_REDIS_REST_TOKEN=

# OWN indicative opportunity. Liquidity defaults to zero and must only be set
# from a verified server-side funding source.
OWN_AVAILABLE_LIQUIDITY_USD=0
OWN_INDICATIVE_APR=0.065
OWN_TERM_MONTHS=24

# OWN request delivery. Both URL and secret are required in production.
OWN_LEAD_WEBHOOK_URL=
OWN_LEAD_WEBHOOK_SECRET=
OWN_LEAD_WEBHOOK_TIMEOUT_MS=5000
OWN_LEAD_DEVELOPMENT_MOCK=false

# Standalone engine app
HOST=127.0.0.1
PORT=4000

# Required for the internal workbench in production.
UNDERWRITER_USERNAME=
UNDERWRITER_PASSWORD=

# Optional live data source configuration.
# Live support: Ethereum RPC powers Aave v3, Compound III, SparkLend,
# allowlisted wallet discovery, and ENS. Morpho uses its official GraphQL API.
# Keep these server-only; never expose them through NUXT_PUBLIC_*.
ETHEREUM_RPC_URL=
NUXT_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# Set only after the primary URL is an authenticated paid RPC.
POWERRR_RPC_AUTHENTICATED=false
AAVE_V3_GRAPHQL_URL=
AAVE_V4_GRAPHQL_URL=
MORPHO_GRAPHQL_URL=https://api.morpho.org/graphql
NUXT_MORPHO_GRAPHQL_URL=https://api.morpho.org/graphql
EULER_DATA_URL=
SPARK_DATA_URL=
ALCHEMY_API_KEY=
